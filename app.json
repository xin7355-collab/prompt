{
  "expo": {
    "name": "咒語盒 Spellbox",
    "slug": "spellbox",
    "scheme": "spellbox",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spellbox.app",
      "infoPlist": {
        "CFBundleDisplayName": "咒語盒",
        "NSPhotoLibraryUsageDescription": "選擇參考圖來反推提示詞，或把生成的成品圖存回卡片。圖片只留在這台裝置上。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spellbox.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E1211",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "咒語盒 Spellbox",
      "shortName": "咒語盒",
      "lang": "zh-Hant",
      "themeColor": "#0E1211",
      "backgroundColor": "#0E1211",
      "description": "401 則中英雙語 AI 繪圖提示詞、提示詞工作台，以及 26 軸角色工坊。"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "選擇參考圖來反推提示詞，或把生成的成品圖存回卡片。圖片只留在這台裝置上。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
